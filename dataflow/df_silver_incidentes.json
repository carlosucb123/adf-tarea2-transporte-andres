{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(AnioFuente = toInteger(substring(FechaHoraFin, 7, 4)),",
				"          IncidenteId = concat('INC-', lpad(regexReplace(toString(IncidenteId), '[^0-9]', ''), 5, '0')),",
				"          TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          FechaHoraRegistro = toTimestamp(\r",
				"    concat(toString(FechaHoraRegistro), ' 00:00'),\r",
				"    'dd/MM/yyyy HH:mm'\r",
				"),",
				"          Descripcion = trim(Descripcion),",
				"          VehiculoId = regexReplace(toString(VehiculoId), '[^0-9]', '')) ~> derivedColumn1",
				"derivedColumn1 derive(VehiculoId = iif(isNull(VehiculoId), '000', VehiculoId),",
				"          FechaHoraInicio = toTimestamp(FechaHoraInicio, 'dd/MM/yyyy'),",
				"          FechaHoraFin = toTimestamp(FechaHoraFin, 'dd/MM/yyyy')) ~> derivedColumn2",
				"derivedColumn2 filter(!isNull(AnioFuente)",
				"&& !isNull(IncidenteId)",
				"&& trim(toString(IncidenteId)) != ''",
				"&& !isNull(TipoIncidente)",
				"&& trim(toString(TipoIncidente)) != ''",
				"&& !isNull(Severidad)",
				"&& trim(toString(Severidad)) != ''",
				"&& !isNull(FechaHoraInicio)",
				"&& !isNull(FechaHoraFin)",
				"&& !isNull(FechaHoraRegistro)",
				"&& !isNull(VehiculoId)",
				"&& trim(toString(VehiculoId)) != ''",
				"&& !isNull(Descripcion)",
				"&& trim(toString(Descripcion)) != '') ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}