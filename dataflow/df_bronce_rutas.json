{
	"name": "df_bronce_rutas",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronce_rutas_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				},
				{
					"dataset": {
						"referenceName": "bronze_rutas_2022_xls",
						"type": "DatasetReference"
					},
					"name": "xls"
				}
			],
			"sinks": [],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          cod_ruta as string,",
				"          nombre_ruta as string,",
				"          origen as string,",
				"          destino as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          AnioFuente as integer,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"source(output(",
				"          cod_ruta as string,",
				"          nombre_ruta as string,",
				"          origen as string,",
				"          destino as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls"
			]
		}
	}
}