{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn2"
				},
				{
					"name": "filter2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "filter3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source2 derive(ViajeId = concat(     substring(trim(ViajeId), 1, 0),     iif(         instr(trim(FechaServicio), '-') > 0,         substring(trim(FechaServicio), 1, 4),         substring(trim(FechaServicio), 7, 4)     ),     '-',     trim(ViajeId) ),",
				"          RutaHistoricaId = toString(RutaHistoricaId),",
				"          VehiculoId = toString(VehiculoId),",
				"          FechaServicio = iif(     instr(trim(FechaServicio), '-') > 0,     toDate(trim(FechaServicio), 'yyyy-MM-dd'),     toDate(trim(FechaServicio), 'dd/MM/yyyy') ),",
				"          HoraSalida = toTimestamp(HoraProgramada, 'HH:mm:ss'),",
				"          HoraLlegada = toTimestamp(HoraLlegada, 'HH:mm:ss'),",
				"          ValidacionesTarjeta = toInteger(trim(ValidacionesTarjeta)),",
				"          KmRecorridos = toDecimal(replace(trim(KmRecorridos), ',', '.'), 8, 1),",
				"          EstadoViaje = toString(EstadoViaje)) ~> derivedColumn2",
				"derivedColumn2 filter(!isNull(ViajeId)) ~> filter2",
				"filter2 derive(HoraSalida = toTimestamp('1900-01-01 00:00:00', 'yyyy-MM-dd HH:mm:ss'),",
				"          HoraLlegada = toTimestamp('1900-01-01 00:00:00', 'yyyy-MM-dd HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 filter(!isNull(AnioFuente)",
				"&& trim(toString(AnioFuente)) != ''",
				"&& upper(trim(toString(AnioFuente))) != 'NULL'",
				"",
				"&& !isNull(ViajeId)",
				"&& trim(toString(ViajeId)) != ''",
				"&& upper(trim(toString(ViajeId))) != 'NULL'",
				"",
				"&& !isNull(RutaHistoricaId)",
				"&& trim(toString(RutaHistoricaId)) != ''",
				"&& upper(trim(toString(RutaHistoricaId))) != 'NULL'",
				"",
				"&& !isNull(VehiculoId)",
				"&& trim(toString(VehiculoId)) != ''",
				"&& upper(trim(toString(VehiculoId))) != 'NULL'",
				"",
				"&& !isNull(FechaServicio)",
				"&& trim(toString(FechaServicio)) != ''",
				"&& upper(trim(toString(FechaServicio))) != 'NULL'",
				"",
				"&& !isNull(HoraProgramada)",
				"&& trim(toString(HoraProgramada)) != ''",
				"&& upper(trim(toString(HoraProgramada))) != 'NULL'",
				"",
				"&& !isNull(HoraSalida)",
				"&& trim(toString(HoraSalida)) != ''",
				"&& upper(trim(toString(HoraSalida))) != 'NULL'",
				"",
				"&& !isNull(HoraLlegada)",
				"&& trim(toString(HoraLlegada)) != ''",
				"&& upper(trim(toString(HoraLlegada))) != 'NULL'",
				"",
				"&& !isNull(ValidacionesTarjeta)",
				"&& trim(toString(ValidacionesTarjeta)) != ''",
				"&& upper(trim(toString(ValidacionesTarjeta))) != 'NULL'",
				"",
				"&& !isNull(KmRecorridos)",
				"&& trim(toString(KmRecorridos)) != ''",
				"&& upper(trim(toString(KmRecorridos))) != 'NULL'",
				"",
				"&& !isNull(EstadoViaje)",
				"&& trim(toString(EstadoViaje)) != ''",
				"&& upper(trim(toString(EstadoViaje))) != 'NULL') ~> filter3",
				"filter3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}