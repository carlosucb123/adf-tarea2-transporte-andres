{
	"name": "df_silver_vehiculos",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(AnioFuente = toInteger(year(iif(instr(toString(VigenciaDesde), '/') > 0, toDate(toString(VigenciaDesde), 'dd/MM/yyyy'), toDate(toString(VigenciaDesde), 'yyyy-MM-dd')))),",
				"          VehiculoId = concat('V-', lpad(regexReplace(VehiculoId, '[^0-9]', ''), 3, '0')),",
				"          Placa = upper(trim(Placa)),",
				"          TipoVehiculo = upper(trim(TipoVehiculo)),",
				"          CapacidadEfectiva = toInteger(CapacidadEfectiva),",
				"          VigenciaDesde = iif(instr(toString(VigenciaHasta), '/') > 0, toDate(toString(VigenciaHasta), 'dd/MM/yyyy'), toDate(toString(VigenciaHasta), 'yyyy-MM-dd')),",
				"          VigenciaHasta = iif(instr(toString(VigenciaHasta), '/') > 0, toDate(toString(VigenciaHasta), 'dd/MM/yyyy'), toDate(toString(VigenciaHasta), 'yyyy-MM-dd'))) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(AnioFuente)",
				"&& trim(toString(AnioFuente)) != ''",
				"&& upper(trim(toString(AnioFuente))) != 'NULL'",
				"",
				"&& !isNull(VehiculoId)",
				"&& trim(toString(VehiculoId)) != ''",
				"&& upper(trim(toString(VehiculoId))) != 'NULL'",
				"",
				"&& !isNull(Placa)",
				"&& trim(toString(Placa)) != ''",
				"&& upper(trim(toString(Placa))) != 'NULL'",
				"",
				"&& !isNull(TipoVehiculo)",
				"&& trim(toString(TipoVehiculo)) != ''",
				"&& upper(trim(toString(TipoVehiculo))) != 'NULL'",
				"",
				"&& !isNull(CapacidadEfectiva)",
				"&& trim(toString(CapacidadEfectiva)) != ''",
				"&& upper(trim(toString(CapacidadEfectiva))) != 'NULL'",
				"",
				"&& !isNull(VigenciaDesde)",
				"&& trim(toString(VigenciaDesde)) != ''",
				"&& upper(trim(toString(VigenciaDesde))) != 'NULL'",
				"",
				"&& !isNull(VigenciaHasta)",
				"&& trim(toString(VigenciaHasta)) != ''",
				"&& upper(trim(toString(VigenciaHasta))) != 'NULL'",
				"",
				"&& !isNull(Estado)",
				"&& trim(toString(Estado)) != ''",
				"&& upper(trim(toString(Estado))) != 'NULL') ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}