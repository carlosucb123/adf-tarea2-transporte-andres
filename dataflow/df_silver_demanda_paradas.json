{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 filter(!isNull(FechaServicio)",
				"&& !isNull(RutaHistoricaId)",
				"&& trim(RutaHistoricaId) != ''",
				"&& !isNull(ParadaHistoricaId)",
				"&& trim(ParadaHistoricaId) != ''",
				"&& !isNull(Franja)",
				"&& trim(Franja) != '') ~> filter1",
				"filter1 derive(RutaHistoricaId = regexExtract(upper(trim(RutaHistoricaId)), '(RH-[0-9]+)', 1)) ~> derivedColumn1",
				"derivedColumn1 derive(AnioFuente = toInteger(substring(toString(FechaServicio), 0, 4)),",
				"          DemandaId = concat('DEM-', toString(FechaServicio, 'yyyyMMdd'), '-', RutaHistoricaId, '-', ParadaHistoricaId, '-', replace(Franja, ' ', '_')),",
				"          FechaServicio = iif(instr(toString(FechaServicio), '/') > 0, toDate(toString(FechaServicio), 'dd/MM/yyyy'), toDate(toString(FechaServicio), 'yyyy-MM-dd')),",
				"          ParadaHistoricaId = upper(trim(ParadaHistoricaId)),",
				"          Franja = upper(trim(Franja)),",
				"          ValidacionesTarjeta = iif(\r",
				"    isNull(ValidacionesTarjeta) || trim(toString(ValidacionesTarjeta)) == '',\r",
				"    toInteger(0),\r",
				"    toInteger(trim(toString(ValidacionesTarjeta)))\r",
				"),",
				"          Descensos = iif(isNull(Descensos), 0, toInteger(Descensos)),",
				"          DemandaNoAtendida = iif(isNull(DemandaNoAtendida), 0, toInteger(DemandaNoAtendida)),",
				"          Metodo = upper(trim(Metodo))) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}